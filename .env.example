# Postgres connection string. On Supabase use the transaction pooler URL (port 6543).
DATABASE_URL=

# Supabase Auth (phone OTP). From the Supabase project's API settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anonymous review tokens: generate with `node scripts/gen-token-keys.mjs`.
TOKEN_PRIVATE_KEY=
TOKEN_PUBLIC_KEY=

# Secret for hashing facility upvotes, e.g. `openssl rand -hex 32`.
UPVOTE_SECRET=

# Local development only: act as this auth.users id without signing in.
# DEV_FAKE_USER_ID=

# Supabase service role (server only): storage for ID-check photos.
SUPABASE_SERVICE_ROLE_KEY=

# Secret for hashing student ID numbers, e.g. `openssl rand -hex 32`. Never change it once set.
ID_HASH_SECRET=

# Vercel sets this for cron requests; used by /api/cron/purge.
CRON_SECRET=

# Phase 2: encrypts misconduct report details. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key makes stored reports unreadable; keep a copy somewhere safe.
REPORT_ENCRYPTION_KEY=
